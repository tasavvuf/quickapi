# QuickAPI Backend Environment Configuration

# Server Port
PORT=3000
NODE_ENV=development

# MongoDB Cluster Connection String (MongoDB Atlas / Replica Set)
# Format: mongodb+srv://<username>:<password>@<cluster-name>.xxxxxx.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/quickapi?retryWrites=true&w=majority

# Optional: set to 'true' to allow fallback to embedded MongoDB if cluster is temporarily unreachable
ALLOW_MEMORY_DB_FALLBACK=false
