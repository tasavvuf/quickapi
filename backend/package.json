{
  "name": "quickapi-backend",
  "version": "1.0.0",
  "description": "QuickAPI backend — Express API proxy, benchmark runner, and doc generator",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "express": "^5.1.0",
    "mongoose": "^8.14.1",
    "mongodb-memory-server": "^10.4.0",
    "axios": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^7.5.0",
    "js-yaml": "^4.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/js-yaml": "^4.0.9",
    "@types/uuid": "^10.0.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "tsx": "^4.19.0",
    "vitest": "^3.1.0"
  },
  "allowScripts": {
    "mongodb-memory-server@10.4.3": true,
    "esbuild@0.28.2": true
  }
}
